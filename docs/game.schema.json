{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetroDOS Game Plugin",
  "oneOf": [
    { "$ref": "#/$defs/storyGame" },
    { "$ref": "#/$defs/webGame" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$" },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$" },
    "storyGame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "manifestVersion", "id", "code", "name", "description", "version", "author", "start", "scenes", "achievements"],
      "properties": {
        "format": { "const": "retrodos.game" },
        "manifestVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "code": { "$ref": "#/$defs/code" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "version": { "$ref": "#/$defs/version" },
        "author": { "$ref": "#/$defs/name" },
        "start": { "$ref": "#/$defs/id" },
        "scenes": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "title", "text", "choices"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "$ref": "#/$defs/name" },
              "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
              "ending": { "enum": ["win", "lose"] },
              "choices": {
                "type": "array", "maxItems": 9,
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["label", "to"],
                  "properties": {
                    "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "to": { "$ref": "#/$defs/id" },
                    "score": { "type": "integer", "minimum": -10000, "maximum": 10000 },
                    "give": { "$ref": "#/$defs/id" },
                    "requires": { "$ref": "#/$defs/id" }
                  }
                }
              }
            }
          }
        },
        "achievements": {
          "type": "array", "maxItems": 50,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "name", "description", "scene"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "$ref": "#/$defs/name" },
              "description": { "$ref": "#/$defs/description" },
              "scene": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "webGame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "manifestVersion", "runtime", "id", "code", "name", "description", "version", "author", "display", "source", "achievements"],
      "properties": {
        "format": { "const": "retrodos.game" },
        "manifestVersion": { "const": 2 },
        "runtime": { "const": "web" },
        "id": { "$ref": "#/$defs/id" },
        "code": { "$ref": "#/$defs/code" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "version": { "$ref": "#/$defs/version" },
        "author": { "$ref": "#/$defs/name" },
        "display": {
          "type": "object", "additionalProperties": false,
          "required": ["width", "height", "scale", "background"],
          "properties": {
            "width": { "type": "integer", "minimum": 240, "maximum": 1920 },
            "height": { "type": "integer", "minimum": 180, "maximum": 1080 },
            "scale": { "enum": ["fit", "pixel"] },
            "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          }
        },
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["html", "css", "javascript"],
          "properties": {
            "html": { "type": "string", "minLength": 1, "maxLength": 100000 },
            "css": { "type": "string", "maxLength": 80000 },
            "javascript": { "type": "string", "minLength": 1, "maxLength": 120000 }
          }
        },
        "achievements": {
          "type": "array", "maxItems": 50,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "name", "description"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "$ref": "#/$defs/name" },
              "description": { "$ref": "#/$defs/description" }
            }
          }
        }
      }
    }
  }
}

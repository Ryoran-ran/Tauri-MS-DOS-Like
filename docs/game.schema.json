{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetroDOS Declarative Game Plugin v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "manifestVersion", "id", "code", "name", "description", "version", "author", "start", "scenes", "achievements"],
  "properties": {
    "format": { "const": "retrodos.game" },
    "manifestVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$" },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$" },
    "author": { "type": "string", "minLength": 1, "maxLength": 120 },
    "start": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$" },
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "text", "choices"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "ending": { "enum": ["win", "lose"] },
          "choices": {
            "type": "array", "maxItems": 9,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["label", "to"],
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "to": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$" },
                "score": { "type": "integer", "minimum": -10000, "maximum": 10000 },
                "give": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$" },
                "requires": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$" }
              }
            }
          }
        }
      }
    },
    "achievements": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "description", "scene"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "scene": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,79}$" }
        }
      }
    }
  }
}

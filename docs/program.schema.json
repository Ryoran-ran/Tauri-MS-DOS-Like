{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetroDOS Program Manifest v1",
  "type": "object",
  "required": [
    "format",
    "manifestVersion",
    "id",
    "code",
    "name",
    "description",
    "version",
    "category",
    "icon",
    "order",
    "aliases",
    "argument",
    "entry"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "retrodos.program"
    },
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,79}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
    },
    "category": {
      "enum": [
        "tools",
        "games",
        "system"
      ]
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "aliases": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,31}$"
      }
    },
    "argument": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "directory",
            "document",
            "drawing",
            "markdown",
            "expression"
          ]
        },
        "default": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "runtime",
            "module"
          ],
          "additionalProperties": false,
          "properties": {
            "runtime": {
              "const": "builtin"
            },
            "module": {
              "enum": [
                "files",
                "todo",
                "calendar",
                "calculator",
                "paint",
                "markdown",
                "vim",
                "dosbox",
                "guess",
                "snake",
                "mines",
                "blocks",
                "adventure",
                "rogue",
                "sysinfo",
                "settings"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "runtime",
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "runtime": {
              "const": "web"
            },
            "path": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-zA-Z0-9_./-]+\\.html$"
            }
          }
        }
      ]
    }
  }
}
